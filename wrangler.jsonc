{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paper-palace",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ORIGIN": "https://paperpalace.minjaek.im",
    "GITHUB_CLIENT_ID": "Iv23liAsDhVrTwfIfZOb",
    "GITHUB_APP_SLUG": "paper-palace-by-minjae",
  },
  "observability": {
    "enabled": false,
  },
  "account_id": "b0ad5c2078e8911b2c39e9e1eacbbece",
  "routes": [
    {
      "pattern": "paperpalace.minjaek.im",
      "custom_domain": true,
    },
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ARXIV_SEARCH", "class_name": "ArxivSearch" },
      { "name": "GITHUB_SESSIONS", "class_name": "GithubSession" },
    ],
  },
  "migrations": [
    { "tag": "arxiv-search-v1", "new_sqlite_classes": ["ArxivSearch"] },
    { "tag": "github-sessions-v1", "new_sqlite_classes": ["GithubSession"] },
  ],
}
